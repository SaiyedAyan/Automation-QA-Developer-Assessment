        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\n// Select the first 5 Hacker News story IDs\nconst topFive = items.slice(0, 5);\n\nreturn topFive.map(item => {\n  const data = item.json;\n\n  // Extract the numeric story ID\n  const id = typeof data === \"number\"\n    ? data\n    : Object.values(data).find(value => typeof value === \"number\");\n\n  if (id === undefined) {\n    throw new Error(\"Could not extract story ID\");\n  }\n\n  return {\n    json: {\n      id: id\n    }\n  };\n});\n"
      },
      "id": "5dfde178-4e35-4486-9ffc-23c966f4f7be",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://hacker-news.firebaseio.com/v0/item/{{$json.id}}.json",
        "options": {}
      },
      "id": "b0f63514-f8e8-466a-b27a-ac7d374ac1b5",
      "name": "HTTP Request1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\n// Get valid Hacker News stories\nconst stories = items\n  .map(item => item.json)\n  .filter(story =>\n    story &&\n    story.type === \"story\" &&\n    story.title &&\n    typeof story.score === \"number\"\n  );\n\n// Sort stories by highest score first\nstories.sort((a, b) => b.score - a.score);\n\n// Keep only the top 5 stories\nconst topStories = stories.slice(0, 5);\n\n// Format the output\nreturn topStories.map(story => ({\n  json: {\n    title: story.title,\n    author: story.by || \"Unknown\",\n    score: story.score,\n    url: story.url || \"\",\n    comments: story.descendants || 0,\n    highScore: story.score > 100\n  }\n}));\n"
      },
      "id": "37b235d2-d537-4c12-801d-92194104e36d",
